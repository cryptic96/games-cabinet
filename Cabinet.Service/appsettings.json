{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Web": {
        "Url": "http://0.0.0.0:5080"
      },
      "Ops": {
        "Url": "http://127.0.0.1:5081"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Bgg": {
    "MinRequestGapSeconds": 5,
    "IncludePrivateInfo": false
  },
  "Sync": {
    "BackgroundEnabled": true,
    "IntervalMinutes": 60,
    "ManualCooldownMinutes": 10,
    "StartupJitterMaxSeconds": 120,
    "StaleAfterHours": 3
  },
  "Layout": {
    "CoverSharePercent": 25,
    "CoverStrategy": "SizeWeighted",
    "ExpansionStackMax": 6,
    "FewGamesThreshold": 12,
    "LieFlatBeforeNewSection": true
  },
  "Images": {
    "AllowedHosts": "cf.geekdo-images.com",
    "MaxMegabytes": 12,
    "MaxMegapixels": 36,
    "DownloadGapMilliseconds": 1000,
    "MaxDownloadsPerRun": 80,
    "RetryFailedAfterHours": 24,
    "PruneGraceDays": 7
  },
  "Art": {
    "FlatMinFillPercent": 97,
    "FlatMaxCornerPercent": 15,
    "ThreeDMaxFillPercent": 93,
    "ThreeDMinCornerPercent": 40
  },
  "Enrichment": {
    "MaxThingRequestsPerRun": 25,
    "RefreshBatchesPerRun": 1,
    "RefreshAfterDays": 7
  },
  "Live": {
    "MaxConnections": 100
  },
  "Prototype": {
    "Enabled": false
  },
  "ReverseProxy": {
    "KnownProxies": []
  }
}
