@{
    var language = SiteLanguage.Resolve(Context);
}
<!DOCTYPE html>
<html lang="@language.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@language.Text.SiteName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cabinet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/card.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <partial name="_Footer" model="language" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
