@page
@inject BuildInfo Build
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Games Cabinet</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cabinet.css" asp-append-version="true" />
</head>
<body>
    <main>
        <h1>Games Cabinet</h1>
        <p>The cabinet is being built. Check back soon to browse the collection.</p>
        <p class="version">Version @Build.Version (@Build.ShortCommit)</p>
    </main>
    <div id="cabinet" class="cabinet" data-sample="65"></div>
    <script type="module" src="~/js/cabinet.js" asp-append-version="true"></script>
</body>
</html>
