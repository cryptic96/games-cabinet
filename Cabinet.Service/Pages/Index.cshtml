@page
@model Cabinet.Service.Pages.IndexModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@using Cabinet.Service.Owner
@using Microsoft.AspNetCore.Html
@using Cabinet.Service.Pages.Owner
@{
    var onOwnerPort = Model.IsOwnerAddress;
    var iconsUrl = FileVersions.AddFileVersionToPath(Request.PathBase, "/img/icons.svg");
    Func<object?, IHtmlContent> languageToggle = @<nav class="lang-toggle" aria-label="@Model.Language.Text.LanguageLabel">
        <a href="@Model.LanguageHref("en")" lang="en" hreflang="en" aria-label="@Model.Language.Text.EnglishName" aria-current="@(Model.Language.Code == "en" ? "true" : null)">EN</a>
        <a href="@Model.LanguageHref("nl")" lang="nl" hreflang="nl" aria-label="@Model.Language.Text.DutchName" aria-current="@(Model.Language.Code == "nl" ? "true" : null)">NL</a>
    </nav>;
}
<a class="skip-link" href="#games-list-start">@Model.Language.Text.SkipLink</a>
<header>
    <h1>@Model.Language.Text.SiteName</h1>
    @if (onOwnerPort)
    {
        <div class="header-aside">
            <span class="owner-plate">@OwnerStrings.Plate</span>
            @languageToggle(null)
        </div>
    }
    else
    {
        @languageToggle(null)
    }
    @if (Model.ShowSyncBlock)
    {
        <div class="sync" data-server-time="@Model.ServerTimeIso" data-last-synced="@Model.LastSyncedIso" data-cooldown-ends="@Model.CooldownEndsIso" data-running="@(Model.Status.Running ? "true" : "false")" data-held-back="@(Model.Status.HeldBack ? "true" : "false")" data-stale-after="@Model.Status.StaleAfterSeconds" data-snapshot-version="@Model.SnapshotVersion">
            @if (Model.HasSyncTime)
            {
                <button type="button" class="sync-time" aria-expanded="false" aria-controls="sync-exact" title="@Model.ExactText"><time datetime="@Model.LastSyncedIso">@Model.RelativeText</time></button>
            }
            else
            {
                <span class="sync-time-text">@Model.RelativeText</span>
            }
            <button type="button" class="sync-button" aria-disabled="false" hidden>@Model.Language.Text.SyncNow</button>
        </div>
        <p id="sync-exact" class="sync-exact" hidden>@(Model.HasSyncTime ? Model.Language.Text.LastSynced(Model.ExactText) : string.Empty)</p>
        <p id="sync-note" class="sync-note" role="status" aria-atomic="true"></p>
        <p class="sync-stale" hidden="@(!Model.StaleNoteVisible)">@Model.StaleNoteText</p>
    }
    @if (onOwnerPort)
    {
        <nav class="owner-bar" data-variant="strip" aria-label="@OwnerStrings.BarLabel">
            <p class="owner-strip-note">@OwnerStrings.StripNote</p>
            @if (Model.OwnerDataUnreadable)
            {
                <p class="owner-strip-note">@OwnerStrings.StripUnreadable</p>
                <a class="owner-strip-action" href="@Url.Content("~/owner/settings")">@OwnerStrings.FixIt</a>
            }
            else if (Model.UnplacedCount > 0)
            {
                <p class="owner-strip-note">@OwnerStrings.StripUnplaced(Model.UnplacedCount)</p>
                <a class="owner-strip-action" href="@Url.Content("~" + OwnerStrings.UnplacedListPath)">@OwnerStrings.PlaceThem</a>
            }
            <span class="owner-strip-links">
                @foreach (var item in OwnerPage.BarItems)
                {
                    <a href="@Url.Content("~" + item.Href)">@item.Name</a>
                }
            </span>
        </nav>
    }
    @if (Model.ShowingSample)
    {
        <p class="status">Invented collection of @Model.ItemCount @(Model.ItemCount == 1 ? "item" : "items").</p>
    }
    @if (Model.PrototypeEnabled)
    {
        <nav class="sample-switcher" aria-label="Collection to show">
            @if (Model.ShowingSample)
            {
                <a href="/">Synced</a>
            }
            else
            {
                <a href="/" aria-current="page">Synced</a>
            }
            @foreach (var name in Model.SampleNames)
            {
                if (Model.ShowingSample && name == Model.SampleName)
                {
                    <a href="/?sample=@name" aria-current="page">@Model.LabelFor(name)</a>
                }
                else
                {
                    <a href="/?sample=@name">@Model.LabelFor(name)</a>
                }
            }
        </nav>
    }
</header>
<div class="filter-sentinel" aria-hidden="true"></div>
<div class="filter-bar" role="search" aria-label="@Model.Language.Text.FilterBarLabel" hidden>
    <div class="filter-row">
        <fieldset class="filter-view" hidden>
            <legend class="visually-hidden">@Model.Language.Text.ViewLegend</legend>
            <label class="filter-view-segment">
                <input type="radio" name="filter-view" value="all" checked />
                <span class="filter-view-text">@Model.Language.Text.ViewAll</span>
            </label>
            <label class="filter-view-segment">
                <input type="radio" name="filter-view" value="location" />
                <span class="filter-view-text">@Model.Language.Text.ViewByLocation</span>
            </label>
        </fieldset>
        <label class="visually-hidden" for="filter-q">@Model.Language.Text.SearchLabel</label>
        <span class="filter-search">
            <input id="filter-q" type="search" name="q" placeholder="@Model.Language.Text.SearchLabel" enterkeyhint="search" autocapitalize="off" autocomplete="off" autocorrect="off" spellcheck="false" dir="auto" aria-keyshortcuts="/" />
            <kbd class="filter-hint" aria-hidden="true">/</kbd>
        </span>
        <button type="button" class="filter-open" aria-haspopup="dialog"><span class="filter-open-text">@Model.Language.Text.FiltersButton</span><span class="visually-hidden filter-open-suffix"></span></button>
        <fieldset class="filter-group" data-filter="players">
            <legend>@Model.Language.Text.PlayersLegend</legend>
            <label class="filter-chip">
                <input type="radio" name="filter-players" value="" checked />
                <span class="filter-chip-text">@Model.Language.Text.AnyChoice</span>
            </label>
            @for (var players = 1; players <= 8; players++)
            {
                <label class="filter-chip">
                    <input type="radio" name="filter-players" value="@players" />
                    <span class="filter-chip-text" aria-hidden="true">@(players == 8 ? "8+" : players.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                    <span class="visually-hidden">@Model.Language.Text.PlayersSuffix(players)</span>
                </label>
            }
        </fieldset>
    </div>
    <div class="filter-row">
        <fieldset class="filter-group" data-filter="time">
            <legend>@Model.Language.Text.TimeLegend</legend>
            <label class="filter-chip">
                <input type="radio" name="filter-time" value="" checked />
                <span class="filter-chip-text">@Model.Language.Text.AnyChoice</span>
            </label>
            @foreach (var minutes in new[] { 30, 45, 60, 90, 120 })
            {
                <label class="filter-chip">
                    <input type="radio" name="filter-time" value="@minutes" />
                    <span class="filter-chip-text" aria-hidden="true">@minutes.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
                    <span class="visually-hidden">@Model.Language.Text.TimeSuffix(minutes)</span>
                </label>
            }
        </fieldset>
        <div class="filter-location" hidden>
            <label class="visually-hidden" for="filter-loc" hidden>@Model.Language.Text.LocationLabel</label>
            <select id="filter-loc" name="location" hidden>
                <option value="">@Model.Language.Text.AnyLocation</option>
            </select>
        </div>
        <div class="filter-status">
            <span class="filter-count" aria-hidden="true"></span>
            <button type="button" class="filter-clear" aria-label="@Model.Language.Text.ClearName">@Model.Language.Text.ClearVisible</button>
            <button type="button" class="filter-clear-icon" aria-label="@Model.Language.Text.ClearName"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><use href="@iconsUrl#i-close"></use></svg></button>
        </div>
    </div>
</div>
<p class="filter-note" hidden></p>
<dialog class="filter-dialog" aria-labelledby="filter-sheet-title">
    <div class="filter-sheet">
        <span class="filter-grip" aria-hidden="true"></span>
        <h2 id="filter-sheet-title" class="visually-hidden">@Model.Language.Text.SheetTitle</h2>
        <div class="filter-sheet-groups"></div>
        <div class="filter-sheet-actions">
            <button type="button" class="filter-sheet-clear" aria-label="@Model.Language.Text.ClearName" hidden>@Model.Language.Text.ClearVisible</button>
            <button type="button" class="filter-done"></button>
        </div>
    </div>
</dialog>
<p id="filter-live" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></p>
<main>
    <section class="games-list" aria-labelledby="games-list-title">
        <h2 id="games-list-title" class="games-list-heading" tabindex="-1">@Model.Language.Text.GamesListHeading</h2>
        <ul class="games-list-items" role="list"></ul>
    </section>
    @if (!Model.ShowingSample && !Model.HasSynced)
    {
        <div class="cabinet-message cabinet-filling">
            <p class="cabinet-message-heading">@Model.Language.Text.FillingHeading</p>
            <p>@Model.Language.Text.FillingBody</p>
        </div>
    }
    @if (Model.ShowingSample)
    {
        <div id="cabinet" class="cabinet" role="group" aria-label="@Model.Language.Text.CabinetLabel" aria-describedby="cabinet-hint" data-sample="@Model.SampleName"></div>
    }
    else
    {
        <div id="cabinet" class="cabinet" role="group" aria-label="@Model.Language.Text.CabinetLabel" aria-describedby="cabinet-hint"></div>
    }
    <p id="cabinet-hint" class="visually-hidden">@Model.Language.Text.CabinetHint</p>
    @if (onOwnerPort)
    {
        <dialog class="card-dialog" aria-labelledby="card-title" data-icons="@iconsUrl" data-edit-href="@Url.Content("~/owner/pictures")"></dialog>
    }
    else
    {
        <dialog class="card-dialog" aria-labelledby="card-title" data-icons="@iconsUrl"></dialog>
    }
    <noscript><p class="cabinet-message">@Model.Language.Text.NoScript</p></noscript>
</main>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/cabinet.js" asp-append-version="true"></script>
    @if (onOwnerPort)
    {
        <script type="module" src="~/js/owner-cabinet.js" asp-append-version="true"></script>
    }
}
