@page
@model Cabinet.Service.Pages.IndexModel
<header>
    <h1>@Model.Language.Text.SiteName</h1>
    <nav class="lang-toggle" aria-label="@Model.Language.Text.LanguageLabel">
        <a href="@Model.LanguageHref("en")" lang="en" hreflang="en" aria-label="@Model.Language.Text.EnglishName" aria-current="@(Model.Language.Code == "en" ? "true" : null)">EN</a>
        <a href="@Model.LanguageHref("nl")" lang="nl" hreflang="nl" aria-label="@Model.Language.Text.DutchName" aria-current="@(Model.Language.Code == "nl" ? "true" : null)">NL</a>
    </nav>
    @if (Model.ShowSyncBlock)
    {
        <div class="sync" data-server-time="@Model.ServerTimeIso" data-last-synced="@Model.LastSyncedIso" data-cooldown-ends="@Model.CooldownEndsIso" data-running="@(Model.Status.Running ? "true" : "false")" data-held-back="@(Model.Status.HeldBack ? "true" : "false")" data-stale-after="@Model.Status.StaleAfterSeconds" data-snapshot-version="@Model.SnapshotVersion">
            @if (Model.HasSyncTime)
            {
                <button type="button" class="sync-time" aria-expanded="false" aria-controls="sync-exact" title="@Model.ExactText"><time datetime="@Model.LastSyncedIso">@Model.RelativeText</time></button>
            }
            else
            {
                <span class="sync-time-text">@Model.RelativeText</span>
            }
            <button type="button" class="sync-button" aria-disabled="false" hidden>@Model.Language.Text.SyncNow</button>
        </div>
        <p id="sync-exact" class="sync-exact" hidden>@(Model.HasSyncTime ? Model.Language.Text.LastSynced(Model.ExactText) : string.Empty)</p>
        <p id="sync-note" class="sync-note" role="status" aria-atomic="true"></p>
        <p class="sync-stale" hidden="@(!Model.StaleNoteVisible)">@Model.StaleNoteText</p>
    }
    @if (Model.ShowingSample)
    {
        <p class="status">Invented collection of @Model.ItemCount @(Model.ItemCount == 1 ? "item" : "items").</p>
    }
    @if (Model.PrototypeEnabled)
    {
        <nav class="sample-switcher" aria-label="Collection to show">
            @if (Model.ShowingSample)
            {
                <a href="/">Synced</a>
            }
            else
            {
                <a href="/" aria-current="page">Synced</a>
            }
            @foreach (var name in Model.SampleNames)
            {
                if (Model.ShowingSample && name == Model.SampleName)
                {
                    <a href="/?sample=@name" aria-current="page">@Model.LabelFor(name)</a>
                }
                else
                {
                    <a href="/?sample=@name">@Model.LabelFor(name)</a>
                }
            }
        </nav>
    }
</header>
<main>
    @if (!Model.ShowingSample && !Model.HasSynced)
    {
        <div class="cabinet-message cabinet-filling">
            <p class="cabinet-message-heading">@Model.Language.Text.FillingHeading</p>
            <p>@Model.Language.Text.FillingBody</p>
        </div>
    }
    @if (Model.ShowingSample)
    {
        <div id="cabinet" class="cabinet" data-sample="@Model.SampleName"></div>
    }
    else
    {
        <div id="cabinet" class="cabinet"></div>
    }
    <noscript><p class="cabinet-message">@Model.Language.Text.NoScript</p></noscript>
</main>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/cabinet.js" asp-append-version="true"></script>
}
