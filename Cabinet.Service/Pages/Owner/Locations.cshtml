@page
@using Cabinet.Service.Owner
@using Cabinet.Service.Pages.Owner
@model Cabinet.Service.Pages.Owner.LocationsModel
@{
    var addDescribedBy = Model.AddError is null ? "new-location-hint" : "new-location-hint new-location-error";
}
<h2>@OwnerStrings.Locations</h2>
<p class="owner-intro">@OwnerStrings.LocationsIntro</p>
@if (Model.Notice is not null)
{
    <div class="owner-notice" data-problem="@(Model.NoticeIsProblem ? "true" : null)">
        <p id="owner-notice" role="@(Model.NoticeIsProblem ? "alert" : "status")">@Model.Notice</p>
        @if (Model.UndoRevision is { } undoRevision)
        {
            <form method="post" asp-page-handler="Undo">
                <input type="hidden" name="revision" value="@undoRevision" />
                <button type="submit" class="owner-btn">@OwnerStrings.UndoButton</button>
            </form>
        }
    </div>
}
@if (!Model.Readable)
{
    <section class="owner-panel">
        <p>@OwnerStrings.OwnerDataUnreadable</p>
    </section>
}
else
{
    <details class="owner-panel loc-panel" id="your-locations" open="@Model.PanelOpen">
        <summary class="loc-summary"><h3 id="locations-heading" data-count="@Model.Locations.Count">@OwnerStrings.LocationsHeading(Model.Locations.Count)</h3></summary>
        <p class="owner-hint loc-helper">@OwnerStrings.LocationsHelper</p>
        <p class="loc-empty" id="loc-empty" hidden="@(Model.Locations.Count > 0)">@OwnerStrings.NoLocationsYet</p>
        <ol class="loc-list" id="loc-list" hidden="@(Model.Locations.Count == 0)">
            @foreach (var item in Model.Items)
            {
                <partial name="_LocationItem" model="item" />
            }
        </ol>
        <template id="loc-item-template">
            <partial name="_LocationItem" model="LocationItemModel.Template(Model.Revision)" />
        </template>
        <form method="post" id="add-location-form" asp-page-handler="AddLocation">
            <input type="hidden" name="revision" value="@Model.Revision" data-page-revision />
            <label for="new-location">@OwnerStrings.NewLocationLabel</label>
            <input id="new-location" name="name" type="text" maxlength="60" required dir="auto" autocomplete="off"
                   aria-describedby="@addDescribedBy"
                   aria-invalid="@(Model.AddError is null ? null : "true")" />
            <p id="new-location-hint" class="owner-hint">@OwnerStrings.NewLocationHint</p>
            <p class="field-error" id="new-location-error" role="alert">@Model.AddError</p>
            <button type="submit" class="owner-btn-primary">@OwnerStrings.AddLocationButton</button>
        </form>
        <div class="row-status" id="new-location-status" role="status"></div>
    </details>
    <section class="owner-panel" aria-labelledby="games-heading">
        <h3 id="games-heading" tabindex="-1">@OwnerStrings.GamesHeading</h3>
        @if (Model.Games.Count == 0)
        {
            <p>@OwnerStrings.NoGamesYet</p>
        }
        else
        {
            <p class="owner-hint" id="no-locations-note" hidden="@(Model.Locations.Count > 0)">@OwnerStrings.AddLocationFirst</p>
            <div class="games-toolbar" id="games-toolbar" hidden>
                <div class="owner-find">
                    <label for="game-find">@OwnerStrings.FindLabel</label>
                    <input id="game-find" type="search" autocomplete="off" dir="auto" />
                </div>
                <label class="owner-switch">
                    <input id="unplaced-switch" type="checkbox" role="switch" checked="@Model.FilterUnplaced" />
                    <span id="unplaced-label">@OwnerStrings.UnplacedLabel(Model.UnplacedCount)</span>
                </label>
                <label class="owner-switch owner-selectall">
                    <input id="select-all" type="checkbox" />
                    <span>@OwnerStrings.SelectAllShown</span>
                </label>
            </div>
            <p class="owner-hint games-count" id="games-count" hidden></p>
            <p class="games-empty" id="games-empty" hidden></p>
            <ul class="game-list" role="list">
                @foreach (var game in Model.Games)
                {
                    <li class="game-row" id="@game.Anchor" data-game-id="@game.GameId" data-entry-id="@game.CollectionId" data-base-id="@game.BaseGameId" data-base-entry-id="@game.BaseEntryId" data-nested="@(game.FollowsBase ? "true" : "false")">
                        <label class="game-pick">
                            <input type="checkbox" class="game-check" value="@game.CollectionId" aria-label="@OwnerStrings.SelectLabel(game.Title)" />
                        </label>
                        @if (game.CoverUrl is not null)
                        {
                            <img class="game-cover" src="@game.CoverUrl" width="@game.CoverWidth" height="@game.CoverHeight" alt="" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="game-cover game-swatch" data-swatch="@game.SwatchColour" aria-hidden="true"></span>
                        }
                        <div class="game-text">
                            <span class="game-title" dir="auto">@game.Title</span>
                            @if (game.CopyLabel is not null)
                            {
                                <span class="pic-tag pic-tag-plain" dir="auto">@game.CopyLabel</span>
                            }
                            <span class="game-meta">
                                <span class="game-where" dir="auto" data-unplaced="@(game.EffectiveLocation is null ? "true" : null)">@(game.EffectiveLocation ?? OwnerStrings.NotPlaced)</span>
                                @if (game.IsExpansion)
                                {
                                    <span class="game-tag">@(game.FollowsBase ? OwnerStrings.ExpansionTag : OwnerStrings.OrphanExpansionTag)</span>
                                }
                                @if (game.FollowsBase)
                                {
                                    <span class="game-follow" dir="auto" hidden="@(game.OwnLocationId is not null)">@OwnerStrings.SameAs(game.BaseTitle ?? string.Empty)</span>
                                }
                            </span>
                        </div>
                        <partial name="_LocationPicker" model="LocationPickerModel.For(game, Model.Locations, Model.Revision)" />
                    </li>
                }
            </ul>
        }
    </section>
    <div class="select-dock" id="select-dock" role="region" aria-label="@OwnerStrings.SelectionLabel" hidden>
        <p class="dock-count" id="dock-count" dir="auto"></p>
        <div class="dock-status" id="dock-status" role="status" tabindex="-1" dir="auto"></div>
        <div class="dock-actions" id="dock-actions">
            <button type="button" class="owner-btn-wall-primary" id="dock-move" aria-haspopup="dialog">@OwnerStrings.MoveToButton</button>
            <button type="button" class="owner-btn-wall" id="dock-clear">@OwnerStrings.ClearButton</button>
        </div>
    </div>
    <dialog class="owner-dialog" id="loc-delete-dialog" aria-labelledby="loc-delete-title" aria-describedby="loc-delete-body">
        <h3 id="loc-delete-title" dir="auto"></h3>
        <p class="warning-line" id="loc-delete-body" dir="auto"><strong></strong> <span></span></p>
        <div class="dialog-actions">
            <button type="button" class="owner-btn-danger" id="loc-delete-confirm">@OwnerStrings.DeleteLocationButton</button>
            <button type="button" class="owner-btn" id="loc-delete-keep" autofocus>@OwnerStrings.KeepItButton</button>
        </div>
    </dialog>
}
@section Scripts {
    <script type="module" src="~/js/owner-locations.js" asp-append-version="true"></script>
}
