@page
@using Cabinet.Domain.Owner
@using Cabinet.Repository.Storage
@using Cabinet.Service.Owner
@using Microsoft.AspNetCore.Html
@model Cabinet.Service.Pages.Owner.SettingsModel
@section Head {
    <link rel="stylesheet" href="~/css/cabinet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cabinet-design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cabinet-wood.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cabinet-modifiers.css" asp-append-version="true" />
}
@{
    ViewData["BannerInPanel"] = true;
    var backup = Model.Backup;
    Func<(string Kind, string Design, string Wood), IHtmlContent> swatch =
        @<span class="look-swatch look-swatch-@item.Kind" aria-hidden="true" data-design="@item.Design" data-wood="@item.Wood" data-backs="@Model.Look.Backs" data-lights="off" data-depth="@Model.Look.Depth"><span class="cabinet"><span class="section"><span class="section-floor"></span><span class="section-body"><span class="cubby" data-board="0" data-row-end="true"><span class="placement" data-kind="cover" data-pattern="plain"></span></span></span><span class="section-top"></span><span class="section-trim"></span><span class="section-base"></span></span></span></span>;
}
<h2>@OwnerStrings.Settings</h2>
<section class="owner-panel" id="finish" aria-labelledby="finish-heading">
    <h3 id="finish-heading">@OwnerStrings.LookHeading</h3>
    <p class="owner-hint">@OwnerStrings.LookHelper</p>
    <div class="look-layout">
        <div class="look-stage">
            <figure class="look-preview" id="look-preview" aria-hidden="true" inert
                    data-design="@Model.Look.Design" data-wood="@Model.Look.Wood" data-backs="@Model.Look.Backs" data-lights="@Model.Look.Lights" data-depth="@Model.Look.Depth"
                    data-sample="@Url.Content("~/js/owner-look-sample.json")">
                <div class="cabinet look-preview-mount" id="look-preview-mount">
                    <div class="section" data-standin></div>
                </div>
            </figure>
            <p class="owner-hint look-line" id="look-current">@OwnerStrings.VisitorsSee(CabinetLooks.Summary(Model.Look))</p>
            <p class="owner-hint look-line" id="look-trying" hidden></p>
            <p class="owner-hint look-line" id="look-no-script">@OwnerStrings.LookNoScript</p>
        </div>
        <div class="look-controls">
            <form method="post" class="look-form" id="look-form" autocomplete="off" asp-page-handler="Look">
                <input type="hidden" name="revision" value="@Model.Revision" data-page-revision />
                <fieldset class="pic-choices look-choices">
                    <legend>@OwnerStrings.DesignLegend</legend>
                    <div class="look-tiles">
                        @foreach (var design in CabinetLook.Designs)
                        {
                            <label class="pic-tile look-tile">
                                @swatch(("design", design, Model.Look.Wood))
                                <span class="pic-caption">
                                    <input type="radio" name="design" value="@design" checked="@(design == Model.Look.Design)" />
                                    <span class="pic-label">@CabinetLook.DesignName(design)</span>
                                </span>
                                <span class="pic-sub">@OwnerStrings.DesignSubLine(design)</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <fieldset class="pic-choices look-choices">
                    <legend>@OwnerStrings.WoodLegend</legend>
                    <div class="look-tiles">
                        @foreach (var wood in CabinetLook.Woods)
                        {
                            <label class="pic-tile look-tile">
                                @swatch(("wood", Model.Look.Design, wood))
                                <span class="pic-caption">
                                    <input type="radio" name="wood" value="@wood" checked="@(wood == Model.Look.Wood)" />
                                    <span class="pic-label">@CabinetLook.WoodName(wood)</span>
                                </span>
                                <span class="pic-sub">@OwnerStrings.WoodSubLine(wood)</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <div class="look-group">
                    <label class="look-choice">
                        <input type="checkbox" role="switch" name="backs" value="painted" checked="@(Model.Look.Backs == "painted")" aria-describedby="look-backs-hint" />
                        <span class="look-choice-text">
                            <span class="look-choice-name">@OwnerStrings.PaintedBacksLabel</span>
                        </span>
                    </label>
                    <p class="owner-hint" id="look-backs-hint">@OwnerStrings.PaintedBacksHint</p>
                </div>
                <fieldset class="look-group" aria-describedby="look-lights-hint">
                    <legend>@OwnerStrings.LightsLegend</legend>
                    @foreach (var lights in CabinetLook.LightChoices)
                    {
                        <label class="look-choice">
                            <input type="radio" name="lights" value="@lights" checked="@(lights == Model.Look.Lights)" />
                            <span class="look-choice-text">
                                <span class="look-choice-name">@CabinetLook.LightsName(lights)</span>
                            </span>
                        </label>
                    }
                    <p class="owner-hint" id="look-lights-hint">@OwnerStrings.LightsHint</p>
                </fieldset>
                <fieldset class="look-group" aria-describedby="look-depth-hint">
                    <legend>@OwnerStrings.DepthLegend</legend>
                    @foreach (var depth in CabinetLook.DepthChoices)
                    {
                        <label class="look-choice">
                            <input type="radio" name="depth" value="@depth" checked="@(depth == Model.Look.Depth)" />
                            <span class="look-choice-text">
                                <span class="look-choice-name">@CabinetLook.DepthName(depth)</span>
                            </span>
                        </label>
                    }
                    <p class="owner-hint" id="look-depth-hint">@OwnerStrings.DepthHint</p>
                </fieldset>
                <fieldset class="look-group" id="look-evening" aria-describedby="look-evening-hint" disabled="@(Model.Look.Lights != "evenings")">
                    <legend>@OwnerStrings.PreviewTimeLegend</legend>
                    <label class="look-choice">
                        <input type="radio" name="preview-time" value="day" checked />
                        <span class="look-choice-text">
                            <span class="look-choice-name">@OwnerStrings.PreviewDay</span>
                        </span>
                    </label>
                    <label class="look-choice">
                        <input type="radio" name="preview-time" value="evening" />
                        <span class="look-choice-text">
                            <span class="look-choice-name">@OwnerStrings.PreviewEvening</span>
                        </span>
                    </label>
                    <p class="owner-hint" id="look-evening-hint">@(Model.Look.Lights == "evenings" ? OwnerStrings.PreviewTimeHint : OwnerStrings.PreviewTimeHintDisabled)</p>
                </fieldset>
                <div class="look-actions">
                    <button type="submit" class="owner-btn owner-btn-primary" id="look-publish">@OwnerStrings.UseForEveryoneButton</button>
                    <button type="button" class="owner-btn" id="look-discard" hidden>@OwnerStrings.BackToCurrentButton</button>
                </div>
            </form>
            <p class="row-status" id="finish-status" role="status" data-problem="@(Model.LookNoticeIsProblem ? "true" : null)">
                @if (Model.LookNotice is not null)
                {
                    <span>@Model.LookNotice</span>
                }
            </p>
            @if (Model.LookUndoRevision is { } undoRevision)
            {
                <form method="post" class="look-undo" asp-page-handler="Undo">
                    <input type="hidden" name="revision" value="@undoRevision" />
                    <button type="submit" class="owner-btn">@OwnerStrings.UndoButton</button>
                </form>
            }
        </div>
    </div>
</section>
<section class="owner-panel" id="backup" aria-labelledby="backup-heading">
    <h3 id="backup-heading">@OwnerStrings.BackupHeading</h3>
    @if (Model.Notice is not null)
    {
        <p class="backup-notice" role="alert">@Model.Notice</p>
    }
    @if (!backup.Readable)
    {
        <p>@OwnerStrings.OwnerDataUnreadable</p>
    }
    else if (!backup.HasData)
    {
        <p class="owner-hint">@OwnerStrings.BackupHelper</p>
        <p id="backup-empty">@OwnerStrings.NothingToBackUp</p>
    }
    else
    {
        <p class="owner-hint">@OwnerStrings.BackupHelper</p>
        <partial name="_OwnerBanner" model="backup" />
        <div class="backup-quiet" id="backup-quiet" hidden="@backup.ShowsBanner">
            <p class="backup-line" id="backup-line" hidden="@(backup.LastDownloadAtUtc is null)">
                @OwnerStrings.DownloadedPrefix
                <time id="backup-time" datetime="@(backup.LastDownloadAtUtc is { } downloaded ? OwnerStrings.TimeAttribute(downloaded) : null)" data-owner-when>@(backup.LastDownloadAtUtc is { } shown ? OwnerStrings.TimeUtcText(shown) : string.Empty)</time>
            </p>
            <form method="post" asp-page="/Owner/Settings" asp-page-handler="Download" data-owner-download>
                <button type="submit" class="owner-btn" data-download-button>@OwnerStrings.DownloadButton</button>
            </form>
        </div>
        <p class="owner-hint backup-footnote">@OwnerStrings.BackupFootnote(OwnerDataStore.KeptVersions)</p>
    }
</section>
<partial name="_OwnerRestorePanel" model="Model" />
@if (backup.Readable)
{
    <section class="owner-panel" id="recent-changes" aria-labelledby="recent-changes-heading">
        <h3 id="recent-changes-heading">@OwnerStrings.RecentChangesHeading</h3>
        <p class="owner-hint">@OwnerStrings.RecentChangesHelper</p>
        @if (Model.VisibleChanges.Count == 0)
        {
            <p id="change-log-empty">@OwnerStrings.NoChangesYet</p>
        }
        else
        {
            <ol class="change-log" id="change-log">
                @for (var index = 0; index <= Model.VisibleChanges.Count; index++)
                {
                    if (Model.DividerAfter == index && backup.LastDownloadAtUtc is { } last)
                    {
                        <li class="change-divider" data-divider>
                            @OwnerStrings.DownloadedPrefix
                            <time datetime="@OwnerStrings.TimeAttribute(last)" data-owner-when>@OwnerStrings.TimeUtcText(last)</time>
                        </li>
                    }

                    if (index < Model.VisibleChanges.Count)
                    {
                        var entry = Model.VisibleChanges[index];
                        <li class="change-entry">
                            <time datetime="@OwnerStrings.TimeAttribute(entry.AtUtc)" data-owner-when data-capitalise>@OwnerStrings.TimeUtcText(entry.AtUtc)</time>
                            <span class="change-text" dir="auto">@entry.Text</span>
                        </li>
                    }
                }
            </ol>
        }
    </section>
}
@section Scripts {
    <script type="module" src="~/js/owner-look.js" asp-append-version="true"></script>
}
