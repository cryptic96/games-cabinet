ASPNETCORE_ENVIRONMENT=Production

# The address the reverse proxy connects from; the deployed value replaces this placeholder.
# It must be the Traefik address: the owner tools trust the forwarded client address only from it.
ReverseProxy__KnownProxies__0=192.0.2.10

# Real values go only into the server env file, never into the repository.
Bgg__Username=replace-with-your-bgg-username
Bgg__Token=replace-with-your-bgg-api-token
Bgg__ContactUrl=https://example.com/your-public-repository

# The owner tools stay off until the three lines below are uncommented and
# filled in with real values on the server, and the second Traefik router and
# its DNS name exist. Uncomment them together: the endpoint without a range
# makes the application refuse to start.
# Kestrel__Endpoints__Owner__Url=http://0.0.0.0:5082
# Owner__AllowedRanges__0=192.0.2.0/24
# Owner__AllowedRanges__1=198.51.100.0/24
