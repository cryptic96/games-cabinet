#!/usr/sbin/nft -f
###
### Rendered by deploy/provision.d/50-firewall.sh from provision.conf and
### installed as /etc/nftables.conf. Default-drop input and forward:
### nothing reaches this host except loopback traffic, already-established
### connections, rate-limited ICMP/ICMPv6, SSH from the admin subnets, and
### the app port and the owner port from the reverse proxy only. Every other
### inbound connection is dropped before it reaches any service. The operations listener binds to
### loopback only and has no rule here.
###
### The output chain keeps the internet open but refuses new connections to
### the home network: after loopback, replies (established traffic, so the
### reverse proxy and SSH sessions keep working), ICMPv6 and DNS to the
### configured resolvers, every new connection to the configured private,
### shared and link-local ranges is rejected at once. Reject rather than drop,
### so a mistaken block fails visibly instead of hanging until a timeout. There
### is no time-protocol exception: the container runs no time daemon and takes
### its clock from the host.
###
flush ruleset

table inet cabinet_filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept
    ct state established,related accept
    ct state invalid drop

    icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 10/second accept
    icmpv6 type { echo-request, destination-unreachable, time-exceeded, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } limit rate 10/second accept

    tcp dport 22 ip saddr { @CABINET_ADMIN_SSH_SOURCES@ } accept
    tcp dport 5080 ip saddr @CABINET_TRAEFIK_IP@ accept
    tcp dport 5082 ip saddr @CABINET_TRAEFIK_IP@ accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy accept;

    oif lo accept
    ct state established,related accept
    meta l4proto ipv6-icmp accept

    ip daddr { @CABINET_EGRESS_RESOLVERS@ } udp dport 53 accept
    ip daddr { @CABINET_EGRESS_RESOLVERS@ } tcp dport 53 accept

    ip daddr { @CABINET_EGRESS_BLOCKED_RANGES@ } counter reject with icmpx type admin-prohibited
    ip6 daddr { @CABINET_EGRESS_BLOCKED_RANGES6@ } counter reject with icmpx type admin-prohibited
  }
}
