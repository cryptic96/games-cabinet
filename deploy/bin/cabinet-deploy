#!/usr/bin/env bash
# Root-owned installer: the only thing that ever changes the running
# deployment. Downloads a release by tag without any credential, checks its
# checksum, verifies its attestation before unpacking anything, refuses
# downgrades, activates the release atomically, accepts it only when the
# loopback health answer reports the expected version, and rolls back
# automatically when it does not. A release that had to be rolled back is
# remembered, so later polls skip it until something newer is published.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "${SCRIPT_DIR}/../lib/common.sh" ]; then
  LIB_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"
else
  LIB_DIR="/usr/local/lib/cabinet"
fi

# shellcheck source=deploy/lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=deploy/lib/deploy.sh
source "${LIB_DIR}/deploy.sh"

DEPLOY_ROOT="${CABINET_DEPLOY_ROOT:-}"
LOCK_PATH="${DEPLOY_ROOT}/run/cabinet-deploy/deploy.lock"
DOWNLOAD_DIR="${DEPLOY_ROOT}/var/lib/cabinet-deploy/downloads"
STATE_DIR="${DEPLOY_ROOT}/var/lib/cabinet-deploy/state"
RELEASES_DIR="${DEPLOY_ROOT}/opt/cabinet/releases"
CURRENT_LINK="${DEPLOY_ROOT}/opt/cabinet/current"
CONF_PATH="${CABINET_DEPLOY_CONF:-${DEPLOY_ROOT}/etc/cabinet/deploy.conf}"

usage() {
  cat <<'EOF_USAGE'
Usage:
  cabinet-deploy poll
  cabinet-deploy install [v<version>] [--from-dir DIR]
  cabinet-deploy rollback [<version>]
  cabinet-deploy verify --artifact FILE --bundle FILE --tag v<version>
EOF_USAGE
}

require_root() {
  if [ -z "$DEPLOY_ROOT" ] && [ "$(id -u)" -ne 0 ]; then
    cabinet_die "cabinet-deploy must run as root"
  fi
}

load_configuration() {
  CABINET_SIGNER_WORKFLOW="${CABINET_SIGNER_WORKFLOW:-.github/workflows/release.yml}"
  CABINET_KEEP_RELEASES="${CABINET_KEEP_RELEASES:-3}"
  CABINET_HEALTH_TIMEOUT_SECONDS="${CABINET_HEALTH_TIMEOUT_SECONDS:-60}"
  CABINET_OPS_URL="${CABINET_OPS_URL:-http://127.0.0.1:5081}"
  CABINET_GITHUB_REPO="${CABINET_GITHUB_REPO:-}"

  cabinet_load_conf "$CONF_PATH"

  [ -n "$CABINET_GITHUB_REPO" ] || cabinet_die "CABINET_GITHUB_REPO is not configured"
}

acquire_lock() {
  mkdir -p "$(dirname "$LOCK_PATH")"
  exec 9>"$LOCK_PATH"
  if ! flock -n 9; then
    cabinet_die "another cabinet-deploy invocation is already running"
  fi
}

active_release_version() {
  if [ -L "$CURRENT_LINK" ]; then
    basename "$(readlink -f "$CURRENT_LINK")"
  fi
}

download_release_asset() {
  local repo="$1" tag="$2" asset_name="$3" destination="$4"
  curl --fail --silent --show-error --location --max-time 120 \
    -o "$destination" \
    "https://github.com/${repo}/releases/download/${tag}/${asset_name}"
}

cmd_verify() {
  local artifact="" bundle="" tag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --artifact) artifact="${2:-}"; shift 2 ;;
      --bundle) bundle="${2:-}"; shift 2 ;;
      --tag) tag="${2:-}"; shift 2 ;;
      *) cabinet_die "verify: unknown argument $1" ;;
    esac
  done

  if [ -z "$artifact" ] || [ -z "$bundle" ] || [ -z "$tag" ]; then
    usage
    cabinet_die "verify requires --artifact, --bundle and --tag"
  fi
  [[ "$tag" =~ $CABINET_STRICT_SEMVER_TAG_REGEX ]] || cabinet_die "tag '$tag' is not a strict semver tag"

  local digest
  digest="$(cabinet_verify_attestation "$artifact" "$bundle" "$CABINET_GITHUB_REPO" "$CABINET_SIGNER_WORKFLOW" "refs/tags/${tag}")" \
    || cabinet_die "attestation verification failed for ${artifact}"
  cabinet_log "attestation verified for $artifact (source digest: $digest)"

  cabinet_commit_on_branch "$CABINET_GITHUB_REPO" "$digest" "main" \
    || cabinet_die "attested commit $digest is not on main"

  printf '%s\n' "$digest"
}

verify_checksum() {
  local artifact="$1" checksum_file="$2"

  [ -f "$checksum_file" ] || cabinet_die "checksum file not found: $checksum_file"
  if ! (cd "$(dirname "$artifact")" && sha256sum --check --status "$(basename "$checksum_file")"); then
    cabinet_die "checksum mismatch for $(basename "$artifact"), refusing to unpack"
  fi
}

cmd_install() {
  local version="" from_dir=""

  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    version="$1"
    shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --from-dir) from_dir="${2:-}"; shift 2 ;;
      *) cabinet_die "install: unknown argument $1" ;;
    esac
  done

  [ -n "$version" ] || { usage; cabinet_die "install requires a version, e.g. v1.2.3"; }
  [[ "$version" =~ $CABINET_STRICT_SEMVER_TAG_REGEX ]] || cabinet_die "tag '$version' is not a strict semver tag"
  local numeric_version="${version#v}"

  local active_version
  active_version="$(active_release_version)"

  if [ -n "$active_version" ]; then
    if [ "$numeric_version" = "$active_version" ] || ! cabinet_semver_gt "$numeric_version" "$active_version"; then
      cabinet_die "refusing to install ${version}: not newer than the active release ${active_version} (use rollback for downgrades)"
    fi
  fi

  local artifact_name="cabinet-${numeric_version}.zip"
  local artifact bundle checksum_file
  if [ -n "$from_dir" ]; then
    artifact="${from_dir}/${artifact_name}"
  else
    local download_dir="${DOWNLOAD_DIR}/${numeric_version}"
    mkdir -p "$download_dir"
    artifact="${download_dir}/${artifact_name}"
    local asset
    for asset in "$artifact_name" "${artifact_name}.sha256" "${artifact_name}.sigstore.json"; do
      download_release_asset "$CABINET_GITHUB_REPO" "$version" "$asset" "${download_dir}/${asset}" \
        || cabinet_die "failed to download ${asset}"
    done
  fi
  checksum_file="${artifact}.sha256"
  bundle="${artifact}.sigstore.json"

  [ -f "$artifact" ] || cabinet_die "artifact not found: $artifact"
  [ -f "$bundle" ] || cabinet_die "attestation bundle not found: $bundle"
  verify_checksum "$artifact" "$checksum_file"

  local digest
  if ! digest="$(cabinet_verify_attestation "$artifact" "$bundle" "$CABINET_GITHUB_REPO" "$CABINET_SIGNER_WORKFLOW" "refs/tags/${version}")"; then
    cabinet_die "attestation verification failed for ${version}, refusing to unpack"
  fi

  if ! cabinet_commit_on_branch "$CABINET_GITHUB_REPO" "$digest" "main"; then
    cabinet_die "attested commit for ${version} is not on main, refusing to unpack"
  fi

  cabinet_log "artifact and provenance verified for ${version} (commit ${digest})"

  local install_status=0
  cabinet_install_verified_release \
    "$version" "$numeric_version" "$artifact" "$active_version" \
    "$RELEASES_DIR" "$CURRENT_LINK" "$STATE_DIR" "$CABINET_KEEP_RELEASES" \
    "$CABINET_OPS_URL" "$CABINET_HEALTH_TIMEOUT_SECONDS" || install_status=$?

  case "$install_status" in
    0)
      cabinet_clear_rejected_version "$STATE_DIR"
      ;;
    "$CABINET_INSTALL_ROLLED_BACK")
      cabinet_record_rejected_version "$numeric_version" "$STATE_DIR"
      cabinet_log "ERROR: release ${numeric_version} failed its health check and was rolled back to ${active_version}"
      return 1
      ;;
    "$CABINET_INSTALL_FAILED")
      cabinet_record_rejected_version "$numeric_version" "$STATE_DIR"
      cabinet_log "ERROR: release ${numeric_version} failed its health check and no healthy release could be restored"
      return 1
      ;;
    *)
      return "$install_status"
      ;;
  esac
}

cmd_rollback() {
  local version="${1:-}"

  if [ -z "$version" ] && [ -f "${STATE_DIR}/previous" ]; then
    version="$(head -n 1 "${STATE_DIR}/previous")"
  fi
  [ -n "$version" ] || cabinet_die "no previous release is recorded; name the version to roll back to"
  version="${version#v}"
  [[ "$version" =~ $CABINET_STRICT_SEMVER_REGEX ]] || cabinet_die "rollback requires a plain version, e.g. 1.2.3"

  local active_version
  active_version="$(active_release_version)"
  [ "$version" != "$active_version" ] || cabinet_die "release ${version} is already the active release"

  local rollback_status=0
  cabinet_rollback_release \
    "$version" "$RELEASES_DIR" "$CURRENT_LINK" "$STATE_DIR" \
    "$CABINET_OPS_URL" "$CABINET_HEALTH_TIMEOUT_SECONDS" || rollback_status=$?

  if [ -n "$active_version" ] && cabinet_semver_gt "$active_version" "$version"; then
    cabinet_record_rejected_version "$active_version" "$STATE_DIR"
    cabinet_log "release ${active_version} is now skipped by polls until a newer release is published"
  fi
  return "$rollback_status"
}

cmd_poll() {
  local tag="" fetch_status=0
  tag="$(cabinet_fetch_latest_release "$CABINET_GITHUB_REPO")" || fetch_status=$?
  if [ "$fetch_status" -eq "$CABINET_STATUS_QUIET" ]; then
    return 0
  fi
  [ "$fetch_status" -eq 0 ] || return 1

  local numeric_tag="${tag#v}"
  local active_version
  active_version="$(active_release_version)"

  if [ -n "$active_version" ] && ! cabinet_semver_gt "$numeric_tag" "$active_version"; then
    cabinet_log "up to date at ${active_version}"
    return 0
  fi

  if cabinet_is_rejected "$numeric_tag" "$STATE_DIR"; then
    cabinet_log "release ${numeric_tag} was rolled back after a failed health check; waiting for a newer release"
    return 0
  fi

  cabinet_log "newer release ${tag} found, installing"
  cmd_install "$tag"
}

main() {
  local subcommand="${1:-}"
  [ -n "$subcommand" ] || { usage; cabinet_die "a subcommand is required"; }
  shift || true

  case "$subcommand" in
    -h|--help)
      usage
      return 0
      ;;
  esac

  require_root
  load_configuration

  case "$subcommand" in
    verify)
      cmd_verify "$@"
      ;;
    poll)
      acquire_lock
      cmd_poll "$@"
      ;;
    install)
      acquire_lock
      cmd_install "$@"
      ;;
    rollback)
      acquire_lock
      cmd_rollback "$@"
      ;;
    *)
      usage
      cabinet_die "unknown subcommand: $subcommand"
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
