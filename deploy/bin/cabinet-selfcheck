#!/usr/bin/env bash
###
### On-host acceptance check: proves a provisioned host is correct. Prints one
### PASS or FAIL line per check and exits 1 when any check failed. Run as root.
### Command output is captured into a variable before it is matched, never
### piped into a quiet grep, so an early-closed pipe cannot fake a pass.
###
set -uo pipefail

readonly APP_UNIT="cabinet.service"
readonly TIMER_UNIT="cabinet-deploy-poll.timer"
readonly POLL_UNIT="cabinet-deploy-poll.service"
readonly DEPLOY_CONF="/etc/cabinet/deploy.conf"
readonly DEFAULT_OPS_URL="http://127.0.0.1:5081"

SELFCHECK_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SELFCHECK_BIN_DIR}/../lib/common.sh" ]]; then
  SELFCHECK_LIB_DIR="${SELFCHECK_BIN_DIR}/../lib"
else
  SELFCHECK_LIB_DIR="/usr/local/lib/cabinet"
fi
# shellcheck source=deploy/lib/common.sh
source "${SELFCHECK_LIB_DIR}/common.sh" 2>/dev/null

###
### The prefix under which the provisioning comparison looks up the active
### release and the installed files. Always empty on a real host and never
### read from the environment, so the root-run selfcheck cannot be redirected;
### the offline tests reassign it after sourcing this file.
###
SELFCHECK_ROOT=""

PASSED=0
FAILED=0

usage() {
  cat <<'EOF'
Usage: cabinet-selfcheck [-h|--help]

Checks, as root, that this host is correctly provisioned: units, the app
unit's resource limits against the container's own, file modes,
listeners (the app, the loopback ops port and the optional owner port),
the owner tools' address walls when the owner port is on, firewall, the
outbound block that refuses new connections to the home network (and that DNS
still works), health at the installed version, that the installed
scripts, libraries and units match the active release, SSH key-only login, no
GitHub credential or Actions runner, and the image smoke in a sandbox.
Prints PASS or FAIL per check and exits 1 when any check fails.
EOF
}

pass() { echo "PASS - $*"; PASSED=$((PASSED + 1)); }
fail() { echo "FAIL - $*"; FAILED=$((FAILED + 1)); }

### Succeeds when TEXT ($1) contains LINE ($2) as one complete line.
has_line() {
  local text="$1" line="$2"
  [[ $'\n'"$text"$'\n' == *$'\n'"$line"$'\n'* ]]
}

check_units() {
  local unit state
  for unit in "$APP_UNIT" "$TIMER_UNIT"; do
    for state in active enabled; do
      if systemctl "is-${state}" --quiet "$unit"; then
        pass "${unit} is ${state}"
      else
        fail "${unit} is not ${state}"
      fi
    done
  done
}

###
### Room, in MiB, that the app unit's MemoryMax must leave inside the
### container for SSH, journald, nftables and the deploy timer.
###
readonly LIMIT_MEMORY_MARGIN_MIB=128

### Prints the memory the container shows through lxcfs, in KiB.
container_memory_kib() {
  awk '/^MemTotal:/ { print $2 }' /proc/meminfo
}

### Prints the swap the container shows through lxcfs, in KiB.
container_swap_kib() {
  awk '/^SwapTotal:/ { print $2 }' /proc/meminfo
}

### Prints the number of cores the container shows.
container_cores() {
  nproc
}

### Prints the value of the last NAME= line in unit file $1; nothing when absent.
unit_directive() {
  local file="$1" name="$2" value
  value="$(sed -n "s/^${name}=//p" "$file")"
  printf '%s' "${value##*$'\n'}"
}

### Prints size $1 such as 450M, 2G, 512K or plain bytes as bytes; prints
### nothing when it is not a size.
size_to_bytes() {
  local value="$1" number unit
  [[ "$value" =~ ^([0-9]+)([KMGkmg]?)$ ]] || return 0
  number="${BASH_REMATCH[1]}"
  unit="${BASH_REMATCH[2]}"
  case "$unit" in
    K | k) echo $((number * 1024)) ;;
    M | m) echo $((number * 1048576)) ;;
    G | g) echo $((number * 1073741824)) ;;
    *) echo "$number" ;;
  esac
}

### Prints duration $1 such as 800ms, 1s or 1.2s in whole milliseconds; prints
### nothing when it is not a duration in ms or s.
duration_to_ms() {
  local value="$1"
  [[ "$value" =~ ^[0-9]+(\.[0-9]+)?(ms|s)$ ]] || return 0
  LC_ALL=C awk -v v="$value" 'BEGIN { if (v ~ /ms$/) { sub(/ms$/, "", v); printf "%d", v + 0.5 } else { sub(/s$/, "", v); printf "%d", v * 1000 + 0.5 } }'
}

###
### Compares the app unit's effective limits with the directives of the unit
### file systemd loaded, then with what the container shows through lxcfs:
### the unit's MemoryMax must leave the margin inside the container's memory
### and its CPU quota must stay below the whole of the container's cores, so
### SSH, the firewall and the deploy timer keep headroom while the app is
### flooded. A missing directive or an infinite effective value fails. Prints
### sizes and counts only, never an address.
###
check_limits() {
  local fragment property directive effective wanted shown line
  local shown_output max_bytes="" quota_ms="" mem_kib swap_kib cores
  local -A effective_values=()

  fragment="$(systemctl show "$APP_UNIT" --property=FragmentPath --value 2>&1)"
  if [[ -z "$fragment" || ! -r "$fragment" ]]; then
    fail "could not read the loaded unit file of ${APP_UNIT}"
    return
  fi
  if ! shown_output="$(systemctl show "$APP_UNIT" --property=MemoryHigh,MemoryMax,MemorySwapMax,CPUQuotaPerSecUSec,CPUWeight,TasksMax 2>&1)"; then
    fail "could not read the effective limits of ${APP_UNIT}: ${shown_output}"
    return
  fi
  while IFS= read -r line; do
    [[ "$line" == *=* ]] && effective_values["${line%%=*}"]="${line#*=}"
  done <<<"$shown_output"

  for property in MemoryHigh MemoryMax MemorySwapMax CPUQuota CPUWeight TasksMax; do
    directive="$(unit_directive "$fragment" "$property")"
    if [[ -z "$directive" ]]; then
      fail "${property} is not set in the unit file"
      continue
    fi
    if [[ "$property" == "CPUQuota" ]]; then
      effective="${effective_values[CPUQuotaPerSecUSec]:-}"
    else
      effective="${effective_values[$property]:-}"
    fi
    if [[ -z "$effective" || "$effective" == "infinity" ]]; then
      fail "${property} is not in force: systemd reports '${effective:-nothing}'"
      continue
    fi

    case "$property" in
      MemoryHigh | MemoryMax | MemorySwapMax)
        wanted="$(size_to_bytes "$directive")"
        shown="$effective"
        ;;
      CPUQuota)
        wanted=""
        [[ "$directive" =~ ^([0-9]+)%$ ]] && wanted="$((BASH_REMATCH[1] * 10))"
        shown="$(duration_to_ms "$effective")"
        ;;
      *)
        wanted="$directive"
        shown="$effective"
        ;;
    esac
    if [[ -n "$wanted" && "$wanted" == "$shown" ]]; then
      pass "${property} is in force as the unit file sets it"
      [[ "$property" == "MemoryMax" ]] && max_bytes="$shown"
      [[ "$property" == "CPUQuota" ]] && quota_ms="$shown"
    else
      fail "${property} in force (${effective}) does not match the unit file (${directive})"
    fi
  done

  mem_kib="$(container_memory_kib)"
  swap_kib="$(container_swap_kib)"
  cores="$(container_cores)"
  if [[ ! "$mem_kib" =~ ^[0-9]+$ || ! "$swap_kib" =~ ^[0-9]+$ || ! "$cores" =~ ^[0-9]+$ ]]; then
    fail "could not read the container's memory, swap and cores"
    return
  fi
  pass "the container shows $((mem_kib / 1024)) MiB memory, $((swap_kib / 1024)) MiB swap and ${cores} cores"

  if [[ -n "$max_bytes" ]]; then
    if (( max_bytes <= mem_kib * 1024 - LIMIT_MEMORY_MARGIN_MIB * 1048576 )); then
      pass "MemoryMax leaves at least ${LIMIT_MEMORY_MARGIN_MIB} MiB of the container's memory to the rest of the host"
    else
      fail "MemoryMax is above the container's memory minus the ${LIMIT_MEMORY_MARGIN_MIB} MiB margin kept for SSH, journald, nftables and the deploy timer"
    fi
  fi
  if [[ -n "$quota_ms" ]]; then
    if (( quota_ms < cores * 1000 )); then
      pass "the CPU quota stays below the container's ${cores} cores"
    else
      fail "the CPU quota is at or above the whole of the container's ${cores} cores"
    fi
  fi
}

check_path() {
  local path="$1" want_mode="$2" want_owner="$3" actual
  if [[ ! -e "$path" ]]; then
    fail "${path} is missing"
    return
  fi
  actual="$(stat -c '%a %U:%G' "$path")"
  if [[ "$actual" == "${want_mode} ${want_owner}" ]]; then
    pass "${path} is ${want_mode} ${want_owner}"
  else
    fail "${path} is ${actual}, expected ${want_mode} ${want_owner}"
  fi
}

check_modes() {
  check_path /etc/cabinet 750 root:cabinet
  check_path /etc/cabinet/cabinet.env 640 root:cabinet
  check_path /etc/cabinet/deploy.conf 600 root:root
  check_path /etc/cabinet/provision.conf 600 root:root
  check_path /var/lib/cabinet-deploy 700 root:root
  check_path /opt/cabinet/releases 755 root:root
}

### Prints the local address of each listener on port $2 in `ss -ltnH` output $1.
listener_addresses() {
  awk -v port="$2" '{ n = split($4, parts, ":"); if (parts[n] == port) print $4 }' <<<"$1"
}

check_listeners() {
  local sockets ops address loopback_only=1
  if ! sockets="$(ss -ltnH 2>&1)"; then
    fail "could not list listening sockets: ${sockets}"
    return
  fi

  if [[ -n "$(listener_addresses "$sockets" 5080)" ]]; then
    pass "the app listens on port 5080"
  else
    fail "nothing listens on port 5080"
  fi

  ops="$(listener_addresses "$sockets" 5081)"
  if [[ -z "$ops" ]]; then
    fail "nothing listens on the ops port 5081"
    return
  fi
  for address in $ops; do
    case "$address" in
      127.0.0.1:5081 | "[::1]:5081") ;;
      *) loopback_only=0 ;;
    esac
  done
  if [[ "$loopback_only" -eq 1 ]]; then
    pass "the ops port 5081 is bound to loopback only"
  else
    fail "the ops port 5081 is reachable beyond loopback"
  fi

  if [[ -n "$(listener_addresses "$sockets" 5082)" ]]; then
    pass "the owner port 5082 is listening"
  else
    pass "the owner tools are off (nothing listens on port 5082)"
  fi
}

### Prints the HTTP status curl gets for URL $1, with optional extra curl
### arguments after it; prints 000 when nothing answers. Never prints the URL.
http_status() {
  local url="$1"
  shift
  curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$@" "$url" 2>/dev/null || true
}

###
### Proves the owner tools' inner walls from the host: the public port must
### hide the owner pages with a 404, and, when the owner port listens, a
### request from loopback, which is not the known proxy and does not stand
### behind it, must be refused with a 403 whatever X-Forwarded-For claims.
### This proves the refusal, not the forwarded path, which the integration
### tests prove. Reports status codes only; no address or hostname is ever
### printed.
###
check_owner_wall() {
  local sockets status
  status="$(http_status "http://127.0.0.1:5080/owner/pictures")"
  if [[ "$status" == "404" ]]; then
    pass "the public port answers 404 for the owner pages"
  else
    fail "the public port answers status ${status} for the owner pages, expected 404"
  fi

  if ! sockets="$(ss -ltnH 2>&1)"; then
    fail "could not list listening sockets: ${sockets}"
    return
  fi
  if [[ -z "$(listener_addresses "$sockets" 5082)" ]]; then
    pass "the owner tools are off, so there is no owner port to probe"
    return
  fi

  status="$(http_status "http://127.0.0.1:5082/" -H "X-Forwarded-For: 203.0.113.7")"
  if [[ "$status" == "403" ]]; then
    pass "the owner port refuses a request from loopback"
  else
    fail "the owner port answers status ${status} to a request from loopback, expected 403"
  fi
}

###
### Proves host filtering is switched on. The committed default lets every host
### through, and only the server env file narrows it, so a host provisioned
### before the setting existed, or one where it was forgotten, would otherwise
### run unfiltered with no sign of it. A request that names a host the site does
### not serve must be refused with a 400; any other answer means the list of
### allowed hosts is missing or is a wildcard. Reports a status code only.
###
check_host_filter() {
  local status
  status="$(http_status "http://127.0.0.1:5080/" -H "Host: unlisted.example.org")"
  if [[ "$status" == "400" ]]; then
    pass "the app refuses a request for a host that is not listed"
  else
    fail "the app answers status ${status} to a request for an unlisted host, expected 400; set AllowedHosts in /etc/cabinet/cabinet.env"
  fi
}

check_firewall() {
  local ruleset pattern='hook input priority [^;]*; policy drop'
  if ! ruleset="$(nft list table inet cabinet_filter 2>&1)"; then
    fail "could not read the firewall table cabinet_filter: ${ruleset}"
    return
  fi
  if [[ "$ruleset" =~ $pattern ]]; then
    pass "the firewall input chain drops by default"
  else
    fail "the firewall input chain does not default to drop"
  fi

  check_owner_port_firewall "$ruleset"
}

###
### When the owner port listens, the firewall must admit it from one proxy
### address only: a rule for port 5082 with a source address that is not the
### whole internet. Without it the owner port, bound to every address, would be
### open to the whole network and only the client-range wall would be left.
### Skipped when the owner tools are off or the listeners cannot be listed;
### the listener check reports both. Prints no address.
###
check_owner_port_firewall() {
  local ruleset="$1" sockets rule='tcp dport 5082 ip saddr ([0-9a-fA-F.:]+(/[0-9]+)?) accept'
  if ! sockets="$(ss -ltnH 2>&1)" || [[ -z "$(listener_addresses "$sockets" 5082)" ]]; then
    return
  fi
  if [[ "$ruleset" =~ $rule && "${BASH_REMATCH[1]}" != "0.0.0.0/0" ]]; then
    pass "the firewall admits the owner port 5082 from one source address only"
  else
    fail "the firewall has no rule that admits the owner port 5082 from one source address only"
  fi
}

###
### Tries to open a TCP connection to port 80 of ADDRESS ($1) and prints what
### happened: connected, refused when it failed within 2 seconds (the outbound
### block answers at once) or timeout when it took longer. Prints no address.
###
egress_probe() {
  local address="$1" started elapsed
  started="${EPOCHREALTIME//[.,]/}"
  # shellcheck disable=SC2016 # the inner shell expands the address argument
  if timeout 5 bash -c 'exec 3<>/dev/tcp/"$1"/80' _ "$address" 2>/dev/null; then
    echo connected
    return
  fi
  elapsed=$((${EPOCHREALTIME//[.,]/} - started))
  if ((elapsed < 2000000)); then
    echo refused
  else
    echo timeout
  fi
}

### Prints the body of chain $1 from nft ruleset listing $2.
chain_body() {
  awk -v chain="$1" '
    $0 ~ "^[[:space:]]*chain " chain " [{]" { inside = 1; next }
    inside && /^[[:space:]]*}[[:space:]]*$/ { exit }
    inside { print }
  ' <<<"$2"
}

###
### Prints an address inside the first network in the destination set of nft rule line $1: the address after the network
### address, or the network address itself when the entry is a single address.
###
first_blocked_host() {
  local rule="$1" set first prefix=32 octets set_pattern='ip daddr \{ ([^}]+) \}'
  [[ "$rule" =~ $set_pattern ]] || return 0
  set="${BASH_REMATCH[1]}"
  first="${set%%,*}"
  first="${first// /}"
  if [[ "$first" == */* ]]; then
    prefix="${first#*/}"
    first="${first%%/*}"
  fi
  [[ "$first" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 0
  octets=$((BASH_REMATCH[1] << 24 | BASH_REMATCH[2] << 16 | BASH_REMATCH[3] << 8 | BASH_REMATCH[4]))
  if [[ "$prefix" =~ ^[0-9]+$ ]] && ((prefix < 32)); then
    octets=$((octets + 1))
  fi
  printf '%d.%d.%d.%d' $((octets >> 24 & 255)) $((octets >> 16 & 255)) $((octets >> 8 & 255)) $((octets & 255))
}

### Prints the IPv4 reject rule of the output chain in nft ruleset listing $1, or nothing when there is none.
output_v4_reject_rule() {
  local line rule="" v4_pattern='^[[:space:]]*ip daddr \{[^}]+\}.* reject'
  while IFS= read -r line; do
    [[ "$line" =~ $v4_pattern ]] && rule="$line"
  done <<<"$(chain_body output "$1")"
  printf '%s' "$rule"
}

### Prints the packet count the counter in nft rule line $1 shows, or nothing when the rule has no packet count.
rule_packets() {
  local counter_pattern='counter packets ([0-9]+)'
  [[ "$1" =~ $counter_pattern ]] && printf '%s' "${BASH_REMATCH[1]}"
  return 0
}

###
### Proves the outbound block: the output chain must hold a reject rule for
### an IPv4 and for an IPv6 destination set, and a connection attempt to an
### address inside the first blocked IPv4 network must be counted by the reject
### rule. The rule's own packet counter is the evidence, because a connection
### that fails quickly for any other reason, such as a host that answers with a
### reset or a missing route, would look the same from the outside. The probe
### address is derived from the loaded rule, so no address is written down
### anywhere, and none is printed.
###
check_egress() {
  local ruleset output_chain line v4_rule="" v6_rule="" host outcome before after
  local v6_pattern='^[[:space:]]*ip6 daddr \{[^}]+\}.* reject'
  if ! ruleset="$(nft list table inet cabinet_filter 2>&1)"; then
    fail "could not read the firewall table cabinet_filter: ${ruleset}"
    return
  fi
  output_chain="$(chain_body output "$ruleset")"
  v4_rule="$(output_v4_reject_rule "$ruleset")"
  while IFS= read -r line; do
    [[ "$line" =~ $v6_pattern ]] && v6_rule="$line"
  done <<<"$output_chain"

  if [[ -z "$v4_rule" || -z "$v6_rule" ]]; then
    fail "the firewall output chain does not reject new connections to both the blocked IPv4 and IPv6 ranges"
    return
  fi
  pass "the firewall output chain rejects new connections to the blocked IPv4 and IPv6 ranges"

  host="$(first_blocked_host "$v4_rule")"
  if [[ -z "$host" ]]; then
    fail "could not work out a probe address from the blocked IPv4 ranges"
    return
  fi
  before="$(rule_packets "$v4_rule")"
  outcome="$(egress_probe "$host")"
  if ! ruleset="$(nft list table inet cabinet_filter 2>&1)"; then
    fail "could not read the firewall table cabinet_filter after the probe: ${ruleset}"
    return
  fi
  after="$(rule_packets "$(output_v4_reject_rule "$ruleset")")"
  if [[ -z "$before" || -z "$after" ]]; then
    fail "the blocked IPv4 reject rule shows no packet counter, so the probe cannot be confirmed"
  elif ((after > before)); then
    pass "a connection to the first blocked network was counted by the reject rule"
  else
    fail "a connection to the first blocked network was not counted by the reject rule (${outcome})"
  fi
}

### Succeeds when the name $1 resolves through the configured DNS.
resolve_name() {
  getent ahosts "$1" >/dev/null 2>&1
}

### Proves DNS still works while the outbound block is loaded.
check_dns() {
  if resolve_name api.github.com; then
    pass "DNS resolution works"
  else
    fail "DNS resolution failed; check CABINET_EGRESS_RESOLVERS in provision.conf"
  fi
}

ops_url() {
  local configured=""
  if [[ -r "$DEPLOY_CONF" ]]; then
    configured="$(sed -n 's/^CABINET_OPS_URL=//p' "$DEPLOY_CONF")"
    configured="${configured##*$'\n'}"
  fi
  echo "${configured:-$DEFAULT_OPS_URL}"
}

check_health() {
  local url body status version expected
  if [[ ! -L /opt/cabinet/current ]]; then
    fail "/opt/cabinet/current is not a symlink to an installed release"
    return
  fi
  expected="$(basename "$(readlink -f /opt/cabinet/current)")"

  url="$(ops_url)"
  if ! body="$(curl -fsS --max-time 10 "${url}/health" 2>&1)"; then
    fail "the health endpoint ${url}/health did not answer: ${body}"
    return
  fi
  status="$(jq -r '.status // empty' <<<"$body" 2>/dev/null)"
  version="$(jq -r '.version // empty' <<<"$body" 2>/dev/null)"

  if [[ "$status" == "Healthy" ]]; then
    pass "health reports Healthy"
  else
    fail "health status is '${status}', expected Healthy"
  fi
  if [[ -n "$version" && "$version" == "$expected" ]]; then
    pass "health reports version ${version}, the release the current link points at"
  else
    fail "health reports version '${version}', the current link points at '${expected}'"
  fi
}

###
### Compares the installed scripts, libraries and units, byte for byte, with
### the copies shipped in the active release's deploy directory: one PASS when
### they all match, one FAIL per installed file that is missing or differs,
### and a FAIL when there is nothing to compare against or the loaded deploy
### library cannot compare. Only reads; it never copies, installs or runs
### anything, because re-running provisioning is an operator action.
###
check_provisioning_current() {
  local drifted status=0 path

  if ! declare -F cabinet_provisioning_drift > /dev/null; then
    fail "the installed deploy library cannot compare provisioning; re-run deploy/provision.sh from the active release"
    return
  fi

  drifted="$(cabinet_provisioning_drift "${SELFCHECK_ROOT}/opt/cabinet/current/deploy" "$SELFCHECK_ROOT")" || status=$?

  case "$status" in
    0)
      pass "the installed scripts, libraries and units match the active release"
      ;;
    1)
      while IFS= read -r path; do
        fail "${path} does not match the active release; re-run deploy/provision.sh from the active release"
      done <<<"$drifted"
      ;;
    *)
      fail "there is no active release deploy directory to compare the installed scripts, libraries and units against"
      ;;
  esac
}

check_ssh() {
  local settings setting
  if ! settings="$(sshd -T 2>&1)"; then
    fail "could not read the effective sshd configuration: ${settings}"
    return
  fi
  for setting in passwordauthentication kbdinteractiveauthentication; do
    if has_line "$settings" "${setting} no"; then
      pass "SSH ${setting} is off"
    else
      fail "SSH ${setting} is not off"
    fi
  done
}

check_no_github_credentials() {
  local hits unit_env home path found=0
  hits="$(grep -lE '^(export +)?(GH_TOKEN|GITHUB_TOKEN|GH_ENTERPRISE_TOKEN)=' /etc/cabinet/* 2>/dev/null)"
  [[ -n "$hits" ]] && { fail "a GitHub token variable is set in: ${hits//$'\n'/ }"; found=1; }

  unit_env="$(systemctl show "$POLL_UNIT" -p Environment -p EnvironmentFiles 2>&1)"
  if [[ "$unit_env" == *GH_TOKEN* || "$unit_env" == *GITHUB_TOKEN* ]]; then
    fail "a GitHub token variable is set in the poll unit environment"; found=1
  fi

  IFS=: read -r _ _ _ _ _ home _ <<<"$(getent passwd cabinet)"
  for path in /root/.config/gh/hosts.yml /var/lib/cabinet/.config/gh/hosts.yml "${home:-/nonexistent}/.config/gh/hosts.yml"; do
    [[ -e "$path" ]] && { fail "a GitHub CLI credential file exists: ${path}"; found=1; }
  done

  if [[ "$found" -eq 0 ]]; then
    pass "no GitHub credential is present on the host"
  fi
}

check_no_actions_runner() {
  local units files procs path found=0
  units="$(systemctl list-units --all --no-legend --plain 'actions.runner.*' 2>&1)"
  files="$(systemctl list-unit-files --no-legend 'actions.runner.*' 2>&1)"
  procs="$(pgrep -fl 'Runner[.]Listener' 2>&1)"

  [[ -n "$units$files" ]] && { fail "an Actions runner unit exists: ${units}${files}"; found=1; }
  [[ -n "$procs" ]] && { fail "an Actions runner process is running: ${procs}"; found=1; }
  while IFS=: read -r _ _ _ _ _ path _; do
    [[ -n "$path" ]] && compgen -G "${path}/actions-runner*" > /dev/null && { fail "an Actions runner directory exists under ${path}"; found=1; }
  done <<<"$(getent passwd)"
  for path in /opt/actions-runner* /srv/actions-runner*; do
    [[ -e "$path" ]] && { fail "an Actions runner directory exists: ${path}"; found=1; }
  done

  if [[ "$found" -eq 0 ]]; then
    pass "no Actions runner is present on the host"
  fi
}

### Runs the deployed binary's image-smoke command as the service user in a
### transient sandbox: nothing writable, no home, private tmp and devices, no
### namespaces, no capabilities and no network beyond local sockets.
check_image_smoke() {
  local output line passed=""
  output="$(systemd-run --quiet --pipe --wait --collect \
    --uid=cabinet --gid=cabinet \
    --working-directory=/opt/cabinet/current/app \
    --property=NoNewPrivileges=yes \
    --property=ProtectSystem=strict \
    --property=ProtectHome=yes \
    --property=PrivateTmp=yes \
    --property=PrivateDevices=yes \
    --property=ProtectKernelTunables=yes \
    --property=ProtectKernelModules=yes \
    --property=ProtectControlGroups=yes \
    --property=RestrictNamespaces=yes \
    --property=LockPersonality=yes \
    --property=CapabilityBoundingSet= \
    --property=RestrictAddressFamilies=AF_UNIX \
    --property=Environment=DOTNET_NOLOGO=1 \
    /usr/bin/dotnet Cabinet.Service.dll image-smoke 2>&1)"

  while IFS= read -r line; do
    [[ "$line" == "PASS image-smoke "* ]] && passed="$line"
  done <<<"$output"

  if [[ -n "$passed" ]]; then
    pass "image smoke in the production sandbox: ${passed}"
  else
    fail "image smoke did not pass: ${output}"
  fi
}

main() {
  case "${1:-}" in
    -h | --help)
      usage
      return 0
      ;;
    "") ;;
    *)
      usage >&2
      return 2
      ;;
  esac

  if [[ "$(id -u)" -ne 0 ]]; then
    echo "cabinet-selfcheck must be run as root." >&2
    return 1
  fi

  check_units
  check_limits
  check_modes
  check_listeners
  check_owner_wall
  check_host_filter
  check_firewall
  check_egress
  check_dns
  check_health
  check_provisioning_current
  check_ssh
  check_no_github_credentials
  check_no_actions_runner
  check_image_smoke

  echo ""
  echo "cabinet-selfcheck: ${PASSED} passed, ${FAILED} failed"
  [[ "$FAILED" -eq 0 ]]
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
