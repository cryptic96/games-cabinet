# Traefik v3 dynamic (file-provider) configuration for the games cabinet.
# This file is not read by anything in this repository - copy it into the
# existing Traefik host's dynamic configuration directory (the directory its
# file provider already watches) and replace every placeholder below with
# the real values. The real file lives only on the Traefik host.
#
# One router serves the whole site on its own hostname, behind an IP
# allow-list restricted to the home network and VPN. A second router serves
# the owner tools on a hostname of their own, pointing at the owner port.
# Nothing else is routed: the operations listener binds to loopback only and
# is not reachable through the reverse proxy.
#
# The public router also carries an outer wall: a per-client-address rate
# limit and a cap on requests in flight, so a flood is refused at the proxy
# before it reaches the cabinet host. The owner router has neither.
#
# The owner router keeps the cabinet-lan-only allow-list permanently, even
# when the public router later drops its allow-list to open the site to
# everyone. The owner tools must never be reachable from outside the home
# network and VPN, whatever happens to the public router.
#
# The entry point must append the client address to X-Forwarded-For, which
# is Traefik's default. Do not set the notAppendXForwardedFor option on the
# entry point, and do not list client networks under the trustedIPs setting
# of its forwardedHeaders: either lets a caller forge the address the
# application checks.
#
# The application trusts forwarded headers (X-Forwarded-For) only from the
# address configured as ReverseProxy__KnownProxies__0 in the server-side
# application environment file - that value must be this Traefik host's own
# address.
#
# Every hostname and address below is a placeholder from the documentation
# ranges (RFC 5737) or an example.com domain; replace all of them and never
# commit a real value here.

http:
  middlewares:
    cabinet-lan-only:
      ipAllowList:
        sourceRange:
          # Replace with the real LAN subnet.
          - "192.0.2.0/24"
          # Replace with the real VPN subnet.
          - "198.51.100.0/24"

    # Outer wall, part one: a limit on how fast one internet address may
    # request. Traefik counts requests per client address and refuses a
    # sustained flood cheaply, before it reaches the cabinet host. A request
    # over the limit is delayed a little first and then refused with
    # Traefik's plain 429 response; no styled error page is added.
    #
    # The numbers come from a measured first visit and from flooding the
    # public router. One first visit is about 60 requests, all started within
    # a few seconds. A burst of 800 holds about 8 simultaneous first visits
    # from one address (roughly 470 requests) with room to spare, and still
    # holds 8 visits if the collection grows by about two thirds. An average
    # of 60 per second refills one visit's worth of requests every second. A
    # flood from one address gets through about 800 requests plus 60 per
    # second and is refused with the plain 429 after that.
    #
    # The source criterion is set explicitly on purpose. Without it the
    # in-flight limit would count per request host, which puts every client
    # in one shared bucket. A hop-count strategy would be just as wrong on
    # this edge proxy: it reads an empty forwarded header, again one shared
    # bucket. The IPv6 subnet setting groups the addresses of one household
    # into one client.
    cabinet-rate-limit:
      rateLimit:
        average: 60
        period: 1s
        burst: 800
        sourceCriterion:
          ipStrategy:
            ipv6Subnet: 64

    # Outer wall, part two: a cap on requests being served at once per client
    # address, with the same explicit source criterion and the same plain 429
    # refusal. An open live connection is expected to count as in flight for
    # its whole life (the controlled flood test verifies this with about 20
    # held streams), so the amount must stay above the application's own
    # per-address live-connection cap plus the parallel page loads of a group
    # of friends on one address. The amount of 200 is sized as follows: one
    # first visit has at most 17 requests in flight, 8 simultaneous visits make
    # 136, and up to 20 held live streams make 156, which leaves about 28 percent
    # of room.
    cabinet-in-flight:
      inFlightReq:
        amount: 200
        sourceCriterion:
          ipStrategy:
            ipv6Subnet: 64

    # The application sends its own Content-Security-Policy and the rest of
    # the security headers with every response, and they are tested together
    # with the page. The proxy adds only HSTS, because it is the one that
    # terminates TLS. A header set in both places would be sent twice, and a
    # second policy would be combined with the application's and could block
    # the page. Do not add the preload flag: preload needs the apex domain,
    # this is a sub-domain host, and a preload entry is slow to undo.
    cabinet-security-headers:
      headers:
        stsSeconds: 31536000

  routers:
    cabinet:
      rule: "Host(`cabinet.example.com`)"
      entryPoints:
        - websecure
      # Traefik runs a router's middlewares in list order. The security
      # headers come first so the proxy's own refusals (429 from the limits,
      # 403 from the allow-list) carry the HSTS header too. Opening the site
      # to everyone removes only cabinet-lan-only from this list; putting it
      # back closes the site again.
      middlewares:
        - cabinet-security-headers
        - cabinet-lan-only
        - cabinet-rate-limit
        - cabinet-in-flight
      service: cabinet
      tls:
        certResolver: letsencrypt

    # No rate limit on this router, on purpose: the owner tools are reachable
    # from the home network and VPN only, and the owner's pictures page loads
    # many images at once. The application's own sync and live-connection
    # limits still apply.
    cabinet-owner:
      rule: "Host(`owner.example.com`)"
      entryPoints:
        - websecure
      middlewares:
        - cabinet-lan-only
        - cabinet-security-headers
      service: cabinet-owner
      tls:
        certResolver: letsencrypt

  services:
    cabinet:
      loadBalancer:
        servers:
          # Replace with the cabinet host's real address, port 5080.
          - url: "http://192.0.2.20:5080"

    cabinet-owner:
      loadBalancer:
        servers:
          # Replace with the cabinet host's real address, port 5082.
          - url: "http://192.0.2.20:5082"
