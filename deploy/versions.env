# Install source pins consumed by provision.sh and its modules.
# Every value here was checked against its real source by
# deploy/tests/versions-network-test.sh. Re-run that script whenever a pin
# is bumped, and record the values it confirms back into this file.
# Last confirmed against real sources: 2026-10-04.

# .NET ASP.NET Core runtime: comes from Ubuntu's own noble-updates archive;
# the Microsoft package feed does not publish a 24.04 build.
DOTNET_RUNTIME_PACKAGE=aspnetcore-runtime-10.0

# GitHub CLI: needed for offline attestation verification (gh attestation
# verify --bundle); the version floor is the first release with that flag.
GH_CLI_KEY_URL=https://cli.github.com/packages/githubcli-archive-keyring.gpg
GH_CLI_KEY_FINGERPRINT=7F38BBB59D064DBCB3D84D725612B36462313325
GH_CLI_MIN_VERSION=2.49.0
