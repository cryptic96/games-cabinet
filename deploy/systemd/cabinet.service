[Unit]
Description=Games cabinet web application
After=network.target

[Service]
User=cabinet
Group=cabinet
WorkingDirectory=/opt/cabinet/current/app
ExecStart=/usr/bin/dotnet /opt/cabinet/current/app/Cabinet.Service.dll
EnvironmentFile=/etc/cabinet/cabinet.env
Environment=DOTNET_NOLOGO=1
Environment=HOME=/var/lib/cabinet
Environment=DOTNET_gcServer=0
Environment=DOTNET_gcConcurrent=0
Environment=DOTNET_GCHeapHardLimit=0x18000000
StateDirectory=cabinet
Restart=always
RestartSec=10
SyslogIdentifier=cabinet

# Resource limits, sized from the measured sync, picture rebuild and flood (the peak of the whole
# process was about 314 MiB, and one worst-case picture decode adds about 144 MiB) and kept below
# the container's own limits. The runtime does not see the unit's memory limit, so the managed heap
# gets a hard limit of 384 MiB (0x18000000 bytes) of its own, below MemoryHigh.
MemoryHigh=480M
MemoryMax=600M
MemorySwapMax=0
CPUQuota=80%
CPUWeight=50
TasksMax=512
LimitNOFILE=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
