#!/usr/bin/env bash
# Refuses a commit whose staged added lines or staged file names match the
# personal-data denylist. See docs/development.md.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/denylist.sh
. "$HOOK_DIR/lib/denylist.sh"

status=0
denylist_init || status=$?
if [ "$status" -eq "$DENYLIST_ABSENT_STATUS" ]; then
  denylist_warn_absent
  exit 0
fi
if [ "${#DENYLIST_PATTERNS[@]}" -eq 0 ]; then
  exit 0
fi

blocked=0
position=0
while IFS= read -r -d '' path; do
  position=$((position + 1))
  label="$(denylist_safe_label "$path" "staged file" "$position")"
  if [ "$label" != "$path" ]; then
    printf '%s\n' "$path" | denylist_scan "$label" || blocked=1
  fi
  if ! git diff --cached -U0 --no-color --no-ext-diff --no-textconv --text -- ":(literal)$path" | denylist_added_lines | denylist_scan "$label"; then
    blocked=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=d)

if [ "$blocked" -ne 0 ]; then
  echo "blocked: staged content matches the personal-data denylist" >&2
  exit 1
fi
